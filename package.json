{
  "name": "inkdown",
  "productName": "Inkdown",
  "version": "0.1.1",
  "description": "A Typora-like WYSIWYG Markdown editor",
  "author": "Inkdown Contributors",
  "license": "GPL-3.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/akiker233/Inkdown.git"
  },
  "homepage": "https://github.com/akiker233/Inkdown#readme",
  "bugs": {
    "url": "https://github.com/akiker233/Inkdown/issues"
  },
  "keywords": [
    "markdown",
    "editor",
    "wysiwyg",
    "typora",
    "electron",
    "desktop"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "start": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "test": "vitest run",
    "e2e": "node scripts/e2e.mjs",
    "e2e:packaged": "node scripts/e2e.mjs --packaged",
    "icon": "electron scripts/make-icon.cjs",
    "icon:md": "electron scripts/make-file-icon.cjs",
    "logo": "electron scripts/make-logo.cjs",
    "dist": "npm run build && electron-builder --win --publish never",
    "dist:dir": "npm run build && electron-builder --win dir --publish never"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@turbodocx/html-to-docx": "^1.23.1",
    "chokidar": "^4.0.3",
    "electron-updater": "^6.8.9",
    "jszip": "^3.10.2"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@lezer/common": "^1.5.3",
    "@lezer/highlight": "^1.2.5",
    "@lezer/markdown": "^1.8.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.8.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "fuse.js": "^7.5.0",
    "highlight.js": "^11.12.0",
    "katex": "^0.19.0",
    "markdown-it": "^15.0.3",
    "markdown-it-emoji": "^3.1.0",
    "markdown-it-footnote": "^4.0.0",
    "markdown-it-mark": "^4.0.0",
    "markdown-it-sub": "^2.0.0",
    "markdown-it-sup": "^2.0.0",
    "markdown-it-task-lists": "^2.1.1",
    "mermaid": "^12.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vitest": "^5.0.5",
    "zustand": "^5.0.15"
  }
}
